    {
      "id": "model-c++",
      "kind": "model",
      "title": "C++",
      "upstream_stability": "upstream",
      "validation": "engine-integration",
      "options": {
        "schemaName": "*",
        "source-style": "single-source",
        "include-location": "local-include",
        "code-format": "with-getter-setter",
        "wstring": "use-string",
        "const-style": "west-const",
        "just-types": false,
        "namespace": "quicktype",
        "enum-type": "int",
        "type-style": "pascal-case",
        "member-style": "underscore-case",
        "enumerator-style": "upper-underscore-case",
        "boost": false,
        "hide-null-optional": false
      },
      "model_options": [
        {
          "name": "source-style",
          "type": "enum",
          "description": "Source code generation type,  whether to generate single or multiple source files",
          "values": [
            "single-source",
            "multi-source"
          ]
        },
        {
          "name": "include-location",
          "type": "enum",
          "description": "Whether json.hpp is to be located globally or locally",
          "values": [
            "local-include",
            "global-include"
          ]
        },
        {
          "name": "code-format",
          "type": "enum",
          "description": "Generate classes with getters/setters, instead of structs",
          "values": [
            "with-struct",
            "with-getter-setter"
          ]
        },
        {
          "name": "wstring",
          "type": "enum",
          "description": "Store strings using Utf-16 std::wstring, rather than Utf-8 std::string",
          "values": [
            "use-string",
            "use-wstring"
          ]
        },
        {
          "name": "const-style",
          "type": "enum",
          "description": "Put const to the left/west (const T) or right/east (T const)",
          "values": [
            "west-const",
            "east-const"
          ]
        },
        {
          "name": "just-types",
          "type": "boolean",
          "description": "Plain types only"
        },
        {
          "name": "namespace",
          "type": "string",
          "description": "Name of the generated namespace(s)"
        },
        {
          "name": "enum-type",
          "type": "string",
          "description": "Type of enum class"
        },
        {
          "name": "type-style",
          "type": "enum",
          "description": "Naming style for types",
          "values": [
            "pascal-case",
            "original-case",
            "underscore-case",
            "camel-case",
            "upper-underscore-case",
            "pascal-case-upper-acronyms",
            "camel-case-upper-acronyms"
          ]
        },
        {
          "name": "member-style",
          "type": "enum",
          "description": "Naming style for members",
          "values": [
            "pascal-case",
            "original-case",
            "underscore-case",
            "camel-case",
            "upper-underscore-case",
            "pascal-case-upper-acronyms",
            "camel-case-upper-acronyms"
          ]
        },
        {
          "name": "enumerator-style",
          "type": "enum",
          "description": "Naming style for enumerators",
          "values": [
            "pascal-case",
            "original-case",
            "underscore-case",
            "camel-case",
            "upper-underscore-case",
            "pascal-case-upper-acronyms",
            "camel-case-upper-acronyms"
          ]
        },
        {
          "name": "boost",
          "type": "boolean",
          "description": "Require a dependency on boost. Without boost, C++17 is required"
        },
        {
