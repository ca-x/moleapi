{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoleAPI", "version": "0.1.0", "identifier": "com.ca-x.moleapi",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../web" },
    "devUrl": "http://localhost:1420", "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [{ "title": "MoleAPI", "width": 1360, "height": 900, "minWidth": 720, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true, "targets": "all",
    "category": "DeveloperTool", "shortDescription": "A self-hostable, offline API workbench",
    "longDescription": "MoleAPI brings HTTP requests, collections, environments, tests and optional self-hosted synchronization to one private workspace.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }, "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] } },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["English", "SimpChinese"] }, "wix": { "language": ["en-US", "zh-CN"] } }
  }
}
