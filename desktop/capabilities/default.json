{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "MoleAPI native workbench",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write-text-file",
    "dialog:allow-message",
    "core:window:allow-destroy"
  ]
}
