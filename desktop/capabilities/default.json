{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "MoleAPI native workbench",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-fstat",
    "fs:allow-read-dir",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-close",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "dialog:allow-message",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
