MOLEAPI_BIND=127.0.0.1:8787
# Default: local SQLite at ./data/moleapi.db
# MOLEAPI_DATABASE_URL=sqlite://./data/moleapi.db?mode=rwc
# MOLEAPI_DATABASE_URL=postgresql://moleapi:password@localhost:5432/moleapi
# MOLEAPI_DATABASE_URL=mysql://moleapi:password@localhost:3306/moleapi
# A random setup token is generated and printed while the first account is required.
# MOLEAPI_SETUP_TOKEN=your-first-user-setup-token
MOLEAPI_ALLOW_REGISTRATION=false
MOLEAPI_ALLOW_PRIVATE_NETWORK=false
