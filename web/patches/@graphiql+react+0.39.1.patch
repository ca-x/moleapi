new file mode 100644
index 0000000..5700826
--- /dev/null
+++ b/node_modules/@graphiql/react/dist/moleapi-localization.js
@@ -0,0 +1,18 @@
+// MoleAPI localization adapter for the pinned GraphiQL packages.
+import { getI18n, useTranslation } from "react-i18next";
+import { c as compilerCache } from "react-compiler-runtime";
+export function moleapiTranslate(key, values) {
+  return String(getI18n()?.t("GraphiQL:" + key, { ...values, defaultValue: key }) ?? key);
+}
+export function useMoleapiLanguage() { useTranslation(); }
+export function moleapiMemoCache(size) {
+  // Compiler render helpers may run conditionally. Keep native cache semantics
+  // here; only actual React components add a language subscription hook.
+  const cache = compilerCache(size + 1);
+  const language = getI18n()?.language;
+  if (cache[size] !== language) {
+    cache.fill(Symbol.for("react.memo_cache_sentinel"));
+    cache[size] = language;
+  }
+  return cache;
+}
